{
  "_comment": "Copy next to RemoteConnect.Server as appsettings.Production.json. Prefer environment variables for secrets: RemoteConnect__RegistrationKey, RemoteConnect__AdminApiKey.",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5080"
      }
    }
  },
  "RemoteConnect": {
    "DataDirectory": "/var/lib/remoteconnect",
    "RegistrationKey": "",
    "AdminApiKey": "",
    "RelayPairTimeoutSeconds": 30,
    "MaxConcurrentRelays": 200,
    "MaxRelayBytesPerSession": 0,
    "AuditRetentionDays": 90,
    "ResolvePerMinute": 30,
    "RelayRequestsPerMinute": 10,
    "ConnectionsPerMinutePerIp": 120,
    "TrustedProxies": [ "127.0.0.1" ]
  }
}
