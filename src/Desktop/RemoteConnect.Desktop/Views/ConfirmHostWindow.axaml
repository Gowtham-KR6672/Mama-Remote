<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemoteConnect.Desktop.Views.ConfirmHostWindow"
        Title="RemoteConnect — verify device"
        Icon="/Assets/app-icon.png"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
  <StackPanel Margin="22" Spacing="10">
    <TextBlock Text="First connection to this device" Classes="h1" />
    <TextBlock x:Name="TargetText" TextWrapping="Wrap" />
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock x:Name="IdText" FontSize="20" FontWeight="Bold" />
        <SelectableTextBlock x:Name="FingerprintText" Classes="subtle" FontFamily="monospace" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock TextWrapping="Wrap"
               Text="Check that this ID matches the address shown in RemoteConnect on the other computer. RemoteConnect will remember this device and warn you if its identity ever changes." />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Content="Trust and connect" Classes="accent" Click="OnTrust" />
    </StackPanel>
  </StackPanel>
</Window>
