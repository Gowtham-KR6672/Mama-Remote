{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "RemoteConnect": {
    "DataDirectory": "data",
    "RegistrationKey": "",
    "AdminApiKey": "",
    "RelayPairTimeoutSeconds": 30,
    "MaxConcurrentRelays": 200,
    "MaxRelayBytesPerSession": 0,
    "AuditRetentionDays": 90,
    "ResolvePerMinute": 30,
    "RelayRequestsPerMinute": 10,
    "ConnectionsPerMinutePerIp": 120,
    "TrustedProxies": []
  }
}
